# The contract fixtures are byte-compared by both platforms. Without this, core.autocrlf=true
# checks them out as CRLF on Windows while the committed bytes (and the macOS renderer) are LF,
# so a byte-for-byte comparison would fail on one machine and pass on another.
contract-fixtures/** text eol=lf

# Shell scripts have to keep LF endings everywhere. GitHub's Windows runners set
# core.autocrlf=true, so without this a script is checked out with CRLF and bash
# cannot parse it: `set -euo pipefail` becomes `set -euo pipefail\r` and the
# script dies on its first line with "invalid option name". The release gate
# runs on a Windows runner, and a script that cannot start fails the release.
*.sh text eol=lf
